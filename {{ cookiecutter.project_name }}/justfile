# Install the project, its dependencies and its dev tools into .venv
setup:
    uv sync

# Format the code (changes files)
fmt:
    uv run ruff format .
    uv run ruff check --fix .

# Format check, lint and type check, as CI runs them
check:
    uv run ruff format --check .
    uv run ruff check .
    uv run pyright

# Build every part into build/: each module at the top of the package, as
# `python -m`. Stops at the first part that fails.
parts:
    #!/usr/bin/env bash
    set -euo pipefail
    for f in $(find {{ cookiecutter.package_name }} -maxdepth 1 -name "*.py" ! -name "__init__.py" | sort); do
        module="{{ cookiecutter.package_name }}.$(basename "$f" .py)"
        echo "Building $module"
        uv run python -m "$module"
    done
